# GymPulse SaaS - Environment Configuration Template
# Duplicate this file to .env and configure values before deployment

# Application Branding
APP_NAME="GymPulse SaaS"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=false

# Security (Generate a secure 64+ char key using: openssl rand -hex 32)
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default SQLite:
DATABASE_URL="sqlite:///./gympulse.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://username:password@localhost:5432/gympulse_prod"

# CORS Configuration (comma-separated or wildcard)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,https://yourdomain.com"

# AI Assistant Configuration
# Options: "local" (built-in deterministic zero-cost engine), "openai", "gemini", "anthropic"
AI_PROVIDER="local"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# SaaS Tier Quotas
TIER_FREE_MAX_MEMBERS=25
TIER_PRO_MAX_MEMBERS=250
TIER_BUSINESS_MAX_MEMBERS=100000
